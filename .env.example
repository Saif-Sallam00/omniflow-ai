# Neon / Postgres connection string (required)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Port the app serves on (optional, defaults to 5000)
PORT=5000

# --- Admin / session (recommended for production) ---
# Password for the seeded "admin" user. Falls back to a built-in default if unset
# (a warning is logged). Set this before production.
ADMIN_PASSWORD=
# Secret used to sign session cookies. Falls back to a built-in default if unset
# (a warning is logged). Set this before production.
SESSION_SECRET=

# --- Lead email notifications (optional) ---
# If set, a notification email is sent (via Resend) on each new lead. If unset,
# email is skipped silently and the lead is still saved to the database.
RESEND_API_KEY=
# Destination for lead notification emails. Falls back to the app's CONTACT_EMAIL
# constant if unset.
NOTIFY_EMAIL=
